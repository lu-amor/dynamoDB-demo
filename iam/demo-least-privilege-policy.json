{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EscrituraLecturaTablaDemo",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:GetItem",
        "dynamodb:Query"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:REEMPLAZAR_ACCOUNT_ID:table/EventosBigData"
    },
    {
      "Sid": "LecturaStreamDemo",
      "Effect": "Allow",
      "Action": [
        "dynamodb:DescribeStream",
        "dynamodb:GetShardIterator",
        "dynamodb:GetRecords",
        "dynamodb:ListStreams"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:REEMPLAZAR_ACCOUNT_ID:table/EventosBigData/stream/*"
    }
  ]
}
